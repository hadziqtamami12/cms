# ==============================================================================
# Ultra CMS - Environment Configuration Template
# ==============================================================================

# System Installation Flag
# Set to 'false' to trigger the 5-step /setup wizard.
# Set to 'true' once installed to lock /setup.
IS_INSTALLED=false

# Server & Networking
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Security
JWT_SECRET=super_secret_jwt_entropy_key_change_in_production_min32chars

# ------------------------------------------------------------------------------
# Database Driver Selection:
# Supported options: 'supabase' | 'postgresql' | 'mysql' | 'mongodb' | 'firebase' | 'local-json'
# ------------------------------------------------------------------------------
DB_TYPE=local-json

# 1. Supabase Credentials (if DB_TYPE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# 2. PostgreSQL Connection (if DB_TYPE=postgresql)
# e.g., postgresql://user:password@localhost:5432/cms_db?sslmode=require
DATABASE_URL=

# 3. MySQL Connection (if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cms_db

# 4. MongoDB Connection (if DB_TYPE=mongodb)
# e.g., mongodb+srv://user:pass@cluster.mongodb.net/cms_db?retryWrites=true&w=majority
MONGODB_URI=

# 5. Firebase / Firestore (if DB_TYPE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Object Storage Driver Selection:
# Supported options: 'local' | 'cloudflare-r2' | 'aws-s3'
# ------------------------------------------------------------------------------
STORAGE_TYPE=local

# Cloudflare R2 / AWS S3 Credentials (if STORAGE_TYPE is cloudflare-r2 or aws-s3)
S3_BUCKET=my-cms-assets
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_PUBLIC_DOMAIN=https://assets.mywebsite.com
