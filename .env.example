# ==============================================================================
# ENTERPRISE MULTI-INDUSTRY CMS & LANDING PAGE ENGINE
# Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5005
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Dynamic Database Adapter Configuration
# Options for DB_TYPE: 'static' | 'postgres' | 'mysql' | 'mongodb'
# Default is 'static' (Zero-Config JSON, no external server required)
# ------------------------------------------------------------------------------
DB_TYPE=static
DATABASE_URL=postgresql://postgres:password@localhost:5432/cms_db
MYSQL_URL=mysql://root:password@localhost:3306/cms_db
MONGODB_URI=mongodb://localhost:27017/cms_db
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. Dynamic Admin Portal & Authentication
# ------------------------------------------------------------------------------
ADMIN_SLUG=admin
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin123
JWT_SECRET=SUPER_SECURE_ADMIN_JWT_SECRET_2026_x99aF

# ------------------------------------------------------------------------------
# 3. Cryptographic Licensing System & Secret Programmer Master Key
# ------------------------------------------------------------------------------
# Passphrase untuk login ke Secret Programmer Keygen Portal (/keygen)
PROGRAMMER_SECRET_KEY=SuperSecretProgrammerKey2026!

# Master salt matematis untuk pembuatan token lisensi 16-karakter anti-pemalsuan
PROGRAMMER_SECRET_SALT=CMS_PRO_KEYGEN_SALT_2026_x89aF2

# ------------------------------------------------------------------------------
# 4. Multi-Tier Cache Layer (Redis + In-Memory Fallback)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Cloudflare R2 Media Storage (S3-Compatible CDN)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cms-assets
R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com
